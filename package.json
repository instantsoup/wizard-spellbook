{
  "name": "wizard-spellbook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "validate:spells": "node scripts/validate-spells.ts",
    "build:srd": "node scripts/build-srd.ts",
    "coverage": "vitest run --coverage.enabled --coverage.include=src/rules/** --coverage.exclude=src/rules/fixtures.ts --coverage.exclude=src/rules/index.ts --coverage.exclude=**/*.test.ts",
    "e2e": "vite build && playwright test --project=phone",
    "e2e:ios": "vite build && playwright test --project=iphone"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "fake-indexeddb": "^6.2.7",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
